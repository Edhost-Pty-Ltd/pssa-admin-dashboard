# PSSA API — environment variables
# Copy this file to backend/.env and fill in your own values. Never commit .env.

PORT=5000
NODE_ENV=development
# Public site origin. In development both frontends reach the API through their Vite /api proxy.
CLIENT_ORIGIN=http://localhost:5174

# PostgreSQL connection string. Create the database first: createdb -h localhost -U postgres pssa
DATABASE_URL="postgresql://postgres@localhost:5432/pssa?schema=public"

# Authentication — a long random value (at least 32 characters)
JWT_SECRET="extralong-without-a-short-wordings-datatype-with-at-least-89-character"
JWT_EXPIRES_IN_DAYS=7

# Email (SMTP) for OTP codes and transactional mail (decisions, status, reminders).
# Ask the team lead for Brevo/SMTP values; never commit them.
# Scheduled reminders: from backend/ run `npm run jobs:mails` (cron / Task Scheduler daily).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PSSA <example@gmail.com>"
# SMTP_SECURE=true   # only for port 465

# Admin account created by `npm run db:seed` (admins can't sign up through the API).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_FIRST_NAME=PSSA
# ADMIN_LAST_NAME=Admin
# ADMIN_RESET_PASSWORD=true   # re-run the seed with this to change an existing admin's password
